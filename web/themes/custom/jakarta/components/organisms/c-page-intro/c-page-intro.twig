{#
/**
 * @file
 * Template for the component c-page-intro.
 */
#}

{% extends '@jakarta/components/_skeleton/component-base.html.twig' %}

{% set component_name = 'c-page-intro' %}

{% set attr_variant = attr_variant ?: attr['attributes']['variant'] %}

{% set custom_component_classes = [
  attr_variant ? component_name ~ '--' ~ attr_variant|clean_class,
]|merge(c_page_intro_utility_classes ?: []) %}

{% block component_content %}
  <div class="{{ component_name }}__inner container">
    {% if breadcrumb %}
      <div class="{{ component_name }}__breadcrumb">
        {{ breadcrumb }}
      </div>
    {% endif %}
    {% if title %}
      <div class="{{ component_name }}__title">
        {{ include('jakarta:c-heading', {
          content: title,
          heading_tag: 'h1',
          heading_class: 'h1',
        }, with_context = false) }}
      </div>
    {% endif %}
    {% if attr_variant is same as ('lemma') %}
      {% if meta or print or share %}
        <div class="{{ component_name }}__lemma-wrapper">
          {% if meta %}
            <div class="{{ component_name }}__meta">
              {{ meta }}
            </div>
          {% endif %}
          {% if print %}
            <div class="{{ component_name }}__print">
              {{ print }}
            </div>
          {% endif %}
          {% if share %}
            <div class="{{ component_name }}__share">
              {{ share }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endif %}
    {% if attr_variant is same as ('search') or attr_variant is same as ('data-analysis') %}
      <div class="{{ component_name }}__search">
        {% if attr_variant is same as ('search') %}
          {% if search %}
            {{ search }}
          {% endif %}
          <a href="{{ path('view.database_advanced_search.page_6') }}" class="c-header-data-analysis-link" aria-label="{{ 'Go to the advanced data analysis page'|t }}" title="{{ 'Go to the advanced data analysis page'|t }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
            </svg>
          </a>
        {% elseif attr_variant is same as ('data-analysis') %}
          <a href="{{ path('view.database.page_1') }}" class="c-header-data-analysis-link" aria-label="{{ 'Go to the main search page'|t }}" title="{{ 'Go to the main search page'|t }}">
            <i class="c-icon c-icon--search c-icon--search--before"></i>
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
{% endblock %}
