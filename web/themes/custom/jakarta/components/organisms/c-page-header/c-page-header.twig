{#
/**
 * @file
 * Template for the component c-page-header.
 */
#}

{% set header_classes = [
  'c-page-header',
]|merge(c_page_header_utility_classes ?: []) %}

{% if page.nav_left or page.nav or page.nav_right %}
  <header {{ attributes.setAttribute('role', 'banner').addClass(header_classes) }}>
    <div class="container">
      <div class="c-page-header__inner">
        {% block page_header_content %}
          {% if page.nav_left %}
            {{ page.nav_left }}
          {% endif %}
          {% if page.nav and not is_search_page %}
            <div class="c-page-header__search-group">
            {{ page.nav }}
              <a href="{{ path('view.database_advanced_search.page_6') }}" class="c-header-data-analysis-link" aria-label="{{ 'Data analysis'|t }}" title="{{ 'Data analysis'|t }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                </svg>
              </a>
            </div>
          {% endif %}
          {% if page.nav_right %}
            {{ page.nav_right }}
          {% endif %}
          {{ include('jakarta:c-hamburger', with_context = false) }}
        {% endblock %}
      </div>
    </div>
  </header>
{% endif %}
